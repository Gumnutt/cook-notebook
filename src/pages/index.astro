---
import { getCollection } from 'astro:content';
import type { NoteEntry } from '../content.config';
import Layout from '../layouts/Layout.astro';
import Directory from '../components/Directory.astro';

const allNotes: NoteEntry[] = await getCollection('notes');
---

<Layout>
	<header>
		<h1>Cooking Notebook</h1>
		<p>Findings from the kitchen, 2020 → present. {allNotes.length} entries.</p>
	</header>
	<Directory items={allNotes} />
</Layout>
