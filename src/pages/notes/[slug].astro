---
import { getCollection, render } from 'astro:content';
import type { NoteEntry } from '../../content.config';
import Layout from '../../layouts/Layout.astro';

import ReciepeHeader from '../../components/ReciepeHeader.astro';

export async function getStaticPaths() {
  const postEntries = await getCollection('notes');
  return postEntries.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props as { note: NoteEntry };
const { Content } = await render(note);
---
<Layout title={note.data.title}>
	<ReciepeHeader title={note.data.title} description={note.data.description} date={note.data.published} />
	<Content />
  <footer>
    <small><a href="/">← Back to list</a></small>
  </footer>
</Layout> 