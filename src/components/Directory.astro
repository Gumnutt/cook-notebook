---
import type { NoteEntry } from '../content.config';

interface Props {
  items: NoteEntry[];
}

const { items } = Astro.props as Props;

const sortedItems = [...items].sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
---

<cb-directory>
  <ol>
    {sortedItems.map((item, index) => {
      const displayIndex = sortedItems.length - index;

      return (
        <li>
          <a href={`/notes/${item.id}`}>
            <span>{String(displayIndex).padStart(2, '0')}</span>
            <span>{item.data.title}</span>
            <span>
              {item.data.published
                .toLocaleDateString('en-AU', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit',
                })
                .replace(/\//g, '-')}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</cb-directory>